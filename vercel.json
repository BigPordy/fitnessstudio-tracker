{
  "version": 2,
  "buildCommand": "npm run build",
  "public": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/pages/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "0 15 * * * *"
    }
  ]
}
